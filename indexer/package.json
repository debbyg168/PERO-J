{
  "name": "soroban-explorer-indexer",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node src/migrate.js",
    "test": "node --test 'test/*.test.js'",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "docs:generate": "node scripts/generate-openapi.js",
    "build": "npm run docs:generate",
    "prestart": "npm run docs:generate"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "12.3.0",
    "dotenv": "16.4.5",
    "express": "4.19.2",
    "express-rate-limit": "7.4.0",
    "pg": "8.12.0",
    "dotenv": "16.4.5",
    "lru-cache": "11.0.2",
    "swagger-jsdoc": "6.2.8",
    "swagger-ui-express": "5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "9.9.0",
    "eslint": "9.9.0",
    "globals": "15.9.0",
    "prettier": "3.3.3"
  }
}