# ─────────────────────────────────────────────────────────────────────────────
# Production frontend image for PERO-J (used by the staging deployment pipeline).
#
# Build stage produces the Vite production bundle. We invoke `vite build`
# directly rather than `npm run build` (which is `tsc && vite build`), because
# `tsc` currently fails on main with pre-existing type errors unrelated to the
# bundle (tracked separately). The bundle itself builds cleanly. The CI
# workflow still runs `npm run build` to surface type errors independently.
# ─────────────────────────────────────────────────────────────────────────────
FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN ./node_modules/.bin/vite build

# ── Serve stage: nginx serves the static bundle and proxies /api to the
#    in-cluster indexer service (pero-indexer:3001).
FROM nginx:alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 3000
CMD ["nginx", "-g", "daemon off;"]
