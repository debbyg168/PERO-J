# Indexer ---------------------------------------------------------------------
# Soroban RPC endpoint (testnet default)
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Horizon API for classic asset data
HORIZON_URL=https://horizon-testnet.stellar.org
# Ledger to start indexing from (0 resumes from the latest ledger minus 100)
START_LEDGER=0
# Delay between indexer polling cycles in milliseconds
POLL_MS=5000
# Health check lag in seconds before the API reports degraded status
LAG_ALERT_THRESHOLD_S=30

# Database --------------------------------------------------------------------
# PostgreSQL connection string
DATABASE_URL=postgres://user:password@localhost:5432/soroban_explorer
# Maximum PostgreSQL connections in the indexer pool (1-100)
DATABASE_POOL_SIZE=20

# Redis -----------------------------------------------------------------------
# Redis connection string used for caching and rate limiting
REDIS_URL=redis://localhost:6379

# Contract --------------------------------------------------------------------
# Network passphrase used for Stellar RPC and contract simulation
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Deployed explorer contract ID (set after `make deploy`)
EXPLORER_CONTRACT_ID=
# Deployed Oracle contract ID for GET /api/v1/oracle/disputes
ORACLE_CONTRACT_ID=
# Council member Stellar addresses, comma-separated; used by the inactivity monitor
ORACLE_COUNCIL_ROSTER=
# Optional quorum size; defaults to a strict majority of ORACLE_COUNCIL_ROSTER
ORACLE_COUNCIL_QUORUM=
# PagerDuty Events API v2 integration routing key (use a service routed to the council roster)
PAGERDUTY_ROUTING_KEY=
# API server port
PORT=3001

# SEP-41 ----------------------------------------------------------------------
# JSON array of classic assets represented by SAC contracts
SAC_ASSETS=[]
# Account used when simulating SEP-41 metadata calls
OPERATIONAL_ACCOUNT=GCFIRY65OQE7DFP5KLNS2PF2LVZMUZYJX4OZIEQ36N2IQANUB5XVYOJR

# Admin API key for DELETE /api/contracts/:id (set to a strong random value in production)
API_ADMIN_KEY=

# On-chain event submission (optional). When both are set, the indexer submits
# each decoded event to the ExplorerContract via submit_event and records the
# returned on-chain sequence. Leave blank to index without on-chain submission.
SOROBAN_EXPLORER_CONTRACT_ID=
SOROBAN_EXPLORER_ADMIN_SECRET=

# Redis (optional, provisioned by docker-compose for future caching/rate-limit use)
REDIS_URL=redis://localhost:6379

# Frontend: API base URL (Vite env variable, must be prefixed with VITE_)
# In development the frontend proxies /api via Vite, so this can be left blank.
# In production set this to the full API origin, e.g.:
#   VITE_API_URL=https://api.pero-j.io/api
VITE_API_URL=

# Frontend: optimistic bet flow (issue #998)
# Soroban RPC endpoint used to prepare, submit and confirm bet transactions.
# Defaults to testnet when unset.
VITE_SOROBAN_RPC_URL=
# Deployed betting contract invoked by "Place Bet" (C... contract ID).
# Until this is set, the bet slip reports that betting is not configured.
VITE_BETTING_CONTRACT_ID=
# Network passphrase matching the wallet and RPC above; defaults to testnet.
VITE_NETWORK_PASSPHRASE=

# Frontend version traceability (displayed in the footer)
# Set VITE_COMMIT_SHA at build time (e.g. CI) to the git commit SHA.
# Falls back to "local" and "dev" respectively when unset.
#   VITE_COMMIT_SHA=abc1234def567890
#   VITE_APP_VERSION=1.2.3
VITE_COMMIT_SHA=
VITE_APP_VERSION=

# ── Backup (scripts/backup.sh) ────────────────────────────────────────────────
# Local dump directory and retention window
# BACKUP_DIR=./backups
# RETENTION_DAYS=7
#
# S3 remote upload (leave BACKUP_S3_BUCKET blank to skip upload)
# Files are uploaded with SSE-KMS encryption and STANDARD_IA storage class.
# Standard AWS credential env vars (or an IAM role) are used for auth.
# BACKUP_S3_BUCKET=
# BACKUP_S3_PREFIX=postgres-backups
# BACKUP_S3_REGION=us-east-1
